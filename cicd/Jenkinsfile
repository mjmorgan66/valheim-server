#!groovy

@Library('jenkins-library') _


def LABEL= "valheim-server"

def buildContainers = ['docker']

def containers =  containerTemplates.build(buildContainers)

podTemplate(
    label: LABEL,
    containers: containers,
    //volumes: volumes,
    serviceAccount: 'jenkins',
    yaml: '''
    spec:
      securityContext:
        fsGroup: 1000
    ''') {
        timeout(time:10, unit: 'MINUTES') {
            node(LABEL) {
              
                checkout scm
                entrypoint()
            }
        }
}
